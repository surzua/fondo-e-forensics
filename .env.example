# Credenciales opcionales para la API del Banco Central de Chile (si3.bcentral.cl)
# Si no se configuran, el extractor utilizará la API pública de mindicador.cl y web scraping directo
BCENTRAL_USER=
BCENTRAL_PASSWORD=

# Credenciales opcionales para FRED (Federal Reserve Economic Data)
# Si no se configura, el extractor utilizará yfinance como fuente primaria
FRED_API_KEY=

# Configuración de ejecución
LOG_LEVEL=INFO
STREAMLIT_SERVER_PORT=8501
