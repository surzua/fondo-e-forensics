# ==============================================================================
# Git Ignore - Auditoría Cuantitativa Fondo E (fondo-e-forensics)
# ==============================================================================

# Entornos virtuales de Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimizados
__pycache__/
*.py[cod]
*$py.class
*.so

# Caching de librerías y herramientas
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Streamlit
.streamlit/secrets.toml

# Variables de entorno y credenciales (BCentral API keys, etc.)
.env
.env.local
.env.*.local

# Archivos de sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Datos masivos temporales y descargas crudas pesadas
data/raw/*.zip
data/raw/*.tar.gz
data/raw/*.tmp
data/raw/spensiones_carteras/*.zip
data/raw/**/*.parquet
data/interim/*.parquet
data/processed/*.parquet

# Mantener las carpetas en git con .gitkeep
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Excepciones: Tablas estáticas de referencia y calibración actuarial que SI deben versionarse
!data/raw/actuarial/tabla_rv2020.csv
!data/raw/reference/

# Logs
*.log

# Borradores locales de publicación
deliverables/post_linkedin_fondo_e.md
deliverables/kit_viral_linkedin.md
